# Google Gemini API Key (Dùng phân tích báo cáo - Free Tier)
# Lấy key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# Google Gemini Grounding API Key (Tùy chọn - Dùng riêng cho Google Search Grounding với tài khoản Pay-As-You-Go)
GEMINI_GROUNDING_API_KEY=your_grounding_api_key_here

# Cloudflare R2 Storage (S3 Compatible)
# Dùng để lưu trữ kết quả trích xuất định tính BCTN, NQ ĐHCĐ, Báo cáo CTCK
# Chi tiết hướng dẫn: Đăng nhập https://dash.cloudflare.com -> Chọn R2 Object Storage
CLOUDFLARE_R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
R2_BUCKET_NAME=stock-analysis-reports
R2_PUBLIC_DOMAIN=https://pub-xxxx.r2.dev
